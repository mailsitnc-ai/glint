{
  "appId": "com.glint.editor",
  "productName": "Glint",
  "mac": {
    "identity": null,
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "target": ["dir"],
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "dmg": {
    "window": { "width": 540, "height": 380 },
    "iconSize": 100
  },
  "files": ["src/**/*", "package.json"],
  "directories": {
    "app": ".",
    "buildResources": "assets"
  }
}
