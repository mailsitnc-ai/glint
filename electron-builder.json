{
  "appId": "com.glint.editor",
  "productName": "Glint",
  "mac": {
    "identity": null,
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "target": [
      "dmg",
      "zip"
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "icon": "assets/icon.icns"
  },
  "dmg": {
    "window": {
      "width": 540,
      "height": 380
    },
    "iconSize": 100
  },
  "files": [
    "src/**/*",
    "assets/icon.png",
    "assets/icon.ico",
    "package.json"
  ],
  "directories": {
    "app": ".",
    "buildResources": "assets"
  },
  "win": {
    "icon": "assets/icon.ico",
    "target": [
      "nsis",
      "zip"
    ]
  }
}
